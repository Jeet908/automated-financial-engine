APP_ENV=production
PUBLIC_APP_URL=https://your-railway-domain.up.railway.app
ALLOWED_HOSTS=your-railway-domain.up.railway.app
MARKETLENS_DATA_DIR=/data
SESSION_SECRET=change-this-in-production-to-a-secure-random-string

# Plan quotas & pricing
FREE_MONTHLY_VALUATIONS=1
TRIAL_MONTHLY_VALUATIONS=5
PRO_PRICE_PAISE=149900
PRO_MONTHLY_VALUATIONS=25
BUSINESS_PRICE_PAISE=499900
BUSINESS_MONTHLY_VALUATIONS=999
MAX_UPLOAD_BYTES=26214400
TERMS_VERSION=2026-11

# Legal & Compliance
PUBLIC_LEGAL_NAME=MarketLens Analytics
PUBLIC_SUPPORT_EMAIL=support@marketlens.analytics

# Email Verification (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Google OAuth2 SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Multi-Currency Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_BUSINESS=

# -------------------------------------------------------------
# DISTRIBUTED ARCHITECTURE: POSTGRESQL, REDIS & OBJECT STORAGE
# -------------------------------------------------------------
# 1. PostgreSQL (Railway PostgreSQL or AWS RDS / Supabase)
# If omitted or unset, SQLite fallback (/data/marketlens.sqlite3) is used.
# Normalizes postgres:// and postgresql:// to postgresql+psycopg2:// automatically.
DATABASE_URL=postgresql+psycopg2://marketlens:marketlens_secret@localhost:5432/marketlens
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# 2. Redis & Celery Worker Pool (Railway Redis or Upstash)
# If omitted, background tasks run in-process for single-node / local testing.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# 3. Signed Object Storage (Cloudflare R2 or AWS S3)
# If omitted, generated reports (.zip, .xlsx, .pdf, .pptx) are served from local disk.
S3_BUCKET=
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PRESIGN_TTL_SECONDS=900

# -------------------------------------------------------------
# GLOBAL EVENT-DRIVEN REGULATORY & READ-ONLY ERP DATA MESH
# -------------------------------------------------------------
# Token Vault Fernet Symmetric Key (urlsafe-base64 32 bytes)
# If omitted, a deterministic key derived from SESSION_SECRET is used.
TOKEN_ENCRYPTION_KEY=

# UK Companies House REST API Key (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=

# Xero OAuth 2.0 (offline_access accounting.reports.read accounting.transactions.read)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://your-domain.up.railway.app/api/v1/erp/xero/callback

# QuickBooks Online OAuth 2.0 (com.intuit.quickbooks.accounting)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://your-domain.up.railway.app/api/v1/erp/quickbooks/callback

# Zoho Books Multi-DC OAuth 2.0 (ZohoBooks.reports.READ ZohoBooks.accountants.READ)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DC=in
ZOHO_REDIRECT_URI=https://your-domain.up.railway.app/api/v1/erp/zoho/callback

# Oracle NetSuite OneWorld OAuth 2.0 & SuiteQL (rest_webservices)
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_REDIRECT_URI=https://your-domain.up.railway.app/api/v1/erp/netsuite/callback

# TallyPrime / Tally ERP 9 XML-over-HTTP / Relay Agent
TALLY_HOST=localhost
TALLY_PORT=9000

# -------------------------------------------------------------
# GLOBAL PAYMENT RAILS: STRIPE (USD/EUR/GBP) & ENTERPRISE SAML SSO
# -------------------------------------------------------------
# Stripe Global Subscriptions (USD, EUR, GBP)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_USD=price_1ProUSD
STRIPE_PRICE_ID_PRO_EUR=price_1ProEUR
STRIPE_PRICE_ID_PRO_GBP=price_1ProGBP
STRIPE_PRICE_ID_BUSINESS_USD=price_1BizUSD
STRIPE_PRICE_ID_BUSINESS_EUR=price_1BizEUR
STRIPE_PRICE_ID_BUSINESS_GBP=price_1BizGBP

# Enterprise SAML 2.0 SSO (Okta, Azure AD, Google Workspace)
SAML_SP_ENTITY_ID=https://your-domain.up.railway.app/saml/sp
