APP_ENV=production
PUBLIC_APP_URL=https://your-railway-domain.up.railway.app
ALLOWED_HOSTS=your-railway-domain.up.railway.app
MARKETLENS_DATA_DIR=/data
SESSION_SECRET=change-this-in-production-to-a-secure-random-string

# Plan quotas & pricing
FREE_MONTHLY_VALUATIONS=1
TRIAL_MONTHLY_VALUATIONS=5
PRO_PRICE_PAISE=149900
PRO_MONTHLY_VALUATIONS=25
BUSINESS_PRICE_PAISE=499900
BUSINESS_MONTHLY_VALUATIONS=999
MAX_UPLOAD_BYTES=26214400
TERMS_VERSION=2026-11

# Legal & Compliance
PUBLIC_LEGAL_NAME=MarketLens Analytics
PUBLIC_SUPPORT_EMAIL=support@marketlens.analytics

# Email Verification (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Google OAuth2 SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Multi-Currency Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_BUSINESS=

# -------------------------------------------------------------
# DISTRIBUTED ARCHITECTURE: POSTGRESQL, REDIS & OBJECT STORAGE
# -------------------------------------------------------------
# 1. PostgreSQL (Railway PostgreSQL or AWS RDS / Supabase)
# If omitted or unset, SQLite fallback (/data/marketlens.sqlite3) is used.
# Normalizes postgres:// and postgresql:// to postgresql+psycopg2:// automatically.
DATABASE_URL=postgresql+psycopg2://marketlens:marketlens_secret@localhost:5432/marketlens
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# 2. Redis & Celery Worker Pool (Railway Redis or Upstash)
# If omitted, background tasks run in-process for single-node / local testing.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# 3. Signed Object Storage (Cloudflare R2 or AWS S3)
# If omitted, generated reports (.zip, .xlsx, .pdf, .pptx) are served from local disk.
S3_BUCKET=
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PRESIGN_TTL_SECONDS=900
